---
import Icon from "./Icon.astro";
---

<button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch to dark theme">
  <span class="moon"><Icon name="moon" size={18} /></span>
  <span class="sun"><Icon name="sun" size={18} /></span>
</button>

<style>
  .theme-toggle {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border: none;
    padding: 0;
    color: var(--muted);
    transition:
      color 0.15s,
      background 0.15s,
      transform 0.2s;
  }

  .theme-toggle:hover {
    color: var(--accent);
    background: var(--violet);
  }

  .theme-toggle:active {
    transform: scale(0.9);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .moon,
  .sun {
    display: flex;
  }

  /* Same convention as the game: moon while dark, sun while light */
  :global([data-theme="dark"]) .sun,
  :global(:root:not([data-theme="dark"])) .moon {
    display: none;
  }
</style>

<script>
  const KEY = "logodle_dark_v1";
  const root = document.documentElement;

  document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((btn) => {
    const sync = () => {
      const dark = root.dataset.theme === "dark";
      btn.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme");
    };
    sync();

    btn.addEventListener("click", () => {
      const dark = root.dataset.theme !== "dark";
      root.dataset.theme = dark ? "dark" : "light";
      try {
        localStorage.setItem(KEY, dark ? "1" : "0");
      } catch {}
      sync();
    });
  });
</script>
