DEV=true
# WARNING: VITE_STICKER_LOGOS=false switches stickers off for any build that
# sees it, including `brand`. A .env copied from this file does this.
# The variable cannot turn stickers on: that is `stickerLogos` in the brand
# config (src/brands), which also controls the CSP.
VITE_STICKER_LOGOS=false

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
D1_DATABASE_ID=

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
ADMIN_EMAIL=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

RESEND_API_KEY=
EMAIL_FROM=