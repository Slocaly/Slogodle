---
const steps = [
  {
    title: "Name the logo",
    copy: "Every day at midnight a new tech logo appears with its name hidden. Type the company you think it belongs to.",
    color: "var(--title-1)",
  },
  {
    title: "Miss, get a hint",
    copy: "Each wrong guess reveals a clue: first the year the company was founded, then its industry.",
    color: "var(--title-2)",
  },
  {
    title: "Solve in three",
    copy: "Find it within three guesses to keep your streak going. Share your result, then come back tomorrow.",
    color: "var(--title-3)",
  },
];
---

<section id="how" class="how">
  <div class="section-head">
    <span class="pill" style="background: var(--yellow)">HOW TO PLAY</span>
    <h2>One logo. Three guesses.</h2>
  </div>
  <div class="steps">
    {
      steps.map((s, k) => (
        <div class="step" data-step={k + 1} data-active={k === 0 ? "" : undefined}>
          <span class="num" style={`background: ${s.color}`}>
            {k + 1}
          </span>
          <h3>{s.title}</h3>
          <p>{s.copy}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .how {
    max-width: 1160px;
    margin: 0 auto;
    padding: 96px clamp(20px, 5vw, 56px) 64px;
  }

  .section-head {
    margin-bottom: 48px;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 20px;
  }

  .step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
    padding: 32px 28px 36px;
    border-radius: 32px;
    background: var(--surface);
    box-shadow:
      var(--highlight),
      0 4px 0 var(--shadow),
      0 24px 48px -16px var(--shadow);
    transition:
      transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.3s;
  }

  .step[data-active] {
    transform: translateY(-6px);
    box-shadow:
      var(--highlight),
      0 4px 0 var(--accent),
      0 24px 48px -16px var(--shadow);
  }

  .num {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink);
    font-size: 24px;
    font-weight: 700;
    margin-bottom: 6px;
  }

  h3 {
    margin: 0;
    font-size: 22px;
    font-weight: 700;
    line-height: 1.3;
  }

  p {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted);
    max-width: 34ch;
  }
</style>
