---
import Icon from "./Icon.astro";

// Non-interactive replica of the game card, driven by the hero demo script.
// Toggle `data-won` on the root to switch between the playing and solved states.
---

<div class="game-card" data-game-card aria-hidden="true">
  <div class="countdown only-won">
    <span class="countdown-label">Next logo in</span>
    <span class="countdown-value" data-countdown>--:--:--</span>
  </div>

  <div class="card">
    <div class="topbar">
      <div class="number">#1001</div>
      <div class="dots">
        <span class="dot" data-dot></span>
        <span class="dot" data-dot></span>
        <span class="dot" data-dot></span>
      </div>
      <div class="solved only-won">
        <Icon name="check" size={18} />
      </div>
    </div>

    <div class="name">
      <span class="masked only-playing">*x|*x|*x</span>
      <span class="only-won">Slogodle</span>
    </div>

    <div class="logo">
      <div class="glow"></div>
      <img class="mark" src="/slogodle-mark.svg" width="100" height="100" alt="" />
    </div>

    <div class="playing only-playing">
      <div class="input" data-input>
        <span class="typed" data-typed></span><span class="caret"></span>
        <span class="placeholder">What's this logo?</span>
      </div>
      <div class="prompt" data-prompt>Wrong guess reveals a hint.</div>
      <div class="hints" data-hints></div>
      <template data-hint-template>
        <div class="hint">
          <span class="hint-label"></span>
          <span class="hint-text"></span>
        </div>
      </template>
    </div>

    <div class="won only-won">
      <div>Solved in 3/3.</div>
      <div class="share">
        <Icon name="share" size={18} />
        <span>Share result</span>
      </div>
    </div>
  </div>
</div>

<style>
  .game-card {
    position: relative;
    width: 100%;
    max-width: 380px;
    padding-top: 96px;
    color: var(--text);
  }

  .game-card:not([data-won]) .only-won,
  .game-card[data-won] .only-playing {
    display: none !important;
  }

  .countdown {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 10px 28px 12px;
    border-radius: 999px;
    background: var(--surface);
    box-shadow: var(--highlight), 0 3px 0 var(--shadow);
  }

  .countdown-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .countdown-value {
    font-size: 30px;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.15;
    color: var(--yellow);
    font-variant-numeric: tabular-nums;
  }

  .card {
    position: relative;
    width: 100%;
    border-radius: 32px;
    background: var(--surface);
    padding: 32px 40px 48px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    box-shadow: var(--elevation);
  }

  .topbar {
    position: relative;
    width: calc(100% + 44px);
    height: 34px;
    margin: -14px -22px 24px;
  }

  .number {
    position: absolute;
    top: 0;
    left: 0;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--ink);
    background: var(--yellow);
    padding: 6px 16px;
    border-radius: 999px;
  }

  .dots {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    height: 34px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .dot {
    width: 20px;
    height: 8px;
    border-radius: 999px;
    background: var(--border);
  }

  .dot[data-state="wrong"] {
    background: var(--red);
  }

  .dot[data-state="correct"] {
    background: var(--green);
  }

  .solved {
    position: absolute;
    top: 0;
    right: 0;
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: oklch(0.99 0 0);
    background: var(--green);
    box-shadow: 0 4px 10px -2px var(--shadow);
  }

  .name {
    margin-bottom: 6px;
    height: 26px;
    font-size: 19px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .name span {
    display: inline-block;
  }

  .masked {
    filter: blur(7px);
    opacity: 0.65;
    user-select: none;
  }

  .logo {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 140px;
    width: 100%;
    margin-bottom: 28px;
  }

  .glow {
    position: absolute;
    width: 168px;
    height: 168px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--lilac) 0%, transparent 72%);
    opacity: 0.55;
  }

  .mark {
    position: relative;
    display: block;
  }

  .game-card[data-won] .mark {
    filter: drop-shadow(0 0 12px var(--green));
  }

  .playing {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .input {
    width: 100%;
    height: 52px;
    margin-bottom: 16px;
    border: 3px solid var(--text);
    border-radius: 999px;
    background: var(--surface);
    padding: 0 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    box-shadow: 0 4px 0 var(--accent);
  }

  .caret {
    display: inline-block;
    width: 2px;
    height: 18px;
    border-radius: 1px;
    background: var(--accent);
    margin-left: 2px;
    animation: blink 1s steps(1) infinite;
  }

  .placeholder {
    opacity: 0.45;
  }

  .input:not([data-has-typed]) .typed,
  .input:not([data-has-typed]) .caret,
  .input[data-has-typed] .placeholder {
    display: none;
  }

  .prompt {
    font-size: 12px;
    color: var(--muted);
  }

  .prompt[hidden] {
    display: none;
  }

  .hints {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: 10px;
  }

  .hint {
    display: flex;
    flex-direction: column;
    gap: 2px;
    width: 100%;
    background: var(--lilac);
    border-radius: 16px;
    padding: 10px 18px;
    box-shadow: 0 3px 0 var(--shadow);
  }

  .hint-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .hint-text {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: oklch(0.2 0.04 290);
  }

  .won {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
  }

  .share {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 999px;
    background: var(--violet);
    padding: 10px 18px 10px 14px;
    font-size: 13px;
    font-weight: 600;
  }

  @keyframes blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }
</style>
