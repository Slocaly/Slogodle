---
import Close from "../components/Close.astro";
import Faq from "../components/Faq.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import HowToPlay from "../components/HowToPlay.astro";
import Videos from "../components/Videos.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <Hero />
  <HowToPlay />
  <Videos />
  <Faq />
  <Close />
  <Footer />
</Layout>

<script>
  import { buildFrames, countdownToMidnight, renderCard } from "../scripts/demo";
  import { startPile, type Pile } from "../scripts/pile";

  const hero = document.querySelector<HTMLElement>("[data-hero]")!;
  const pileEl = document.querySelector<HTMLElement>("[data-pile]")!;
  const card = document.querySelector<HTMLElement>("[data-game-card]")!;
  const countdown = card.querySelector<HTMLElement>("[data-countdown]")!;
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const pile: Pile = startPile(pileEl, hero);
  const frames = buildFrames();
  // Reduced motion: show the solved card instead of playing the round
  let i = reduceMotion ? frames.length - 1 : 0;

  // Reserve the tallest frame's height so the card growing never shifts the hero layout (and the pile)
  const demo = card.parentElement!;
  let demoWidth = 0;
  const reserveDemoHeight = () => {
    if (demo.clientWidth === demoWidth) return;
    demoWidth = demo.clientWidth;
    let max = 0;
    for (const f of frames) {
      renderCard(card, f);
      max = Math.max(max, card.offsetHeight);
    }
    demo.style.minHeight = `${max}px`;
    show();
  };

  const show = () => renderCard(card, frames[i]);

  // Play the scripted round in a loop, throwing a Slogodle logo on the pile on each win
  const tick = () => {
    setTimeout(() => {
      i = (i + 1) % frames.length;
      if (i === 0) pile.clearLaunched();
      if (frames[i].win) pile.launch(1);
      show();
      tick();
    }, frames[i].hold);
  };

  const updateCountdown = () => (countdown.textContent = countdownToMidnight());

  reserveDemoHeight();
  window.addEventListener("resize", reserveDemoHeight);
  if (!reduceMotion) tick();
  updateCountdown();
  setInterval(updateCountdown, 1000);
</script>
