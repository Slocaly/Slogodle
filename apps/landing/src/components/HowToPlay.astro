---
const steps = [
  {
    title: "Name the logo",
    copy: "Every day at midnight a new tech logo appears with its name hidden. Type the company you think it belongs to.",
    color: "var(--title-1)",
  },
  {
    title: "Miss, get a hint",
    copy: "Each wrong guess reveals a clue: first the year the company was founded, then its industry.",
    color: "var(--title-2)",
  },
  {
    title: "Solve in three",
    copy: "Find it within three guesses to keep your streak going. Share your result, then come back tomorrow.",
    color: "var(--title-3)",
  },
];
---

<section id="how" class="how">
  <div class="head">
    <span class="pill">HOW TO PLAY</span>
    <h2>Three guesses, two hints.</h2>
  </div>
  <ol class="steps">
    {
      steps.map((s, k) => (
        <li class="step">
          <span class="num" style={`background: ${s.color}`}>
            {k + 1}
          </span>
          <div>
            <h3>{s.title}</h3>
            <p>{s.copy}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .how {
    max-width: 1160px;
    margin: 0 auto;
    padding: 96px clamp(20px, 5vw, 56px) 64px;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 56px;
    align-items: start;
  }

  .head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  h2 {
    margin: 16px 0 0;
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 700;
    line-height: 1.1;
  }

  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .step {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: 24px;
    align-items: start;
  }

  .num {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink);
    font-size: 24px;
    font-weight: 700;
    box-shadow:
      var(--highlight),
      0 4px 0 var(--shadow);
  }

  h3 {
    margin: 0 0 6px;
    font-size: 22px;
    font-weight: 700;
    line-height: 1.3;
  }

  p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 46ch;
  }

  /* Mobile: heading stacks above the steps */
  @media (max-width: 860px) {
    .how {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
      padding-top: 64px;
    }

    .step {
      grid-template-columns: 44px minmax(0, 1fr);
      gap: 16px;
    }

    .num {
      width: 44px;
      height: 44px;
      font-size: 20px;
    }
  }
</style>
