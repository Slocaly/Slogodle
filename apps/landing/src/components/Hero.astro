---
import { gameUrl } from "../config";
import GameCard from "./GameCard.astro";
import ThemeToggle from "./ThemeToggle.astro";
import Title from "./Title.astro";
---

<section class="hero" data-hero>
  <div class="pile" data-pile aria-hidden="true"></div>

  <header class="header">
    <Title class="header-title" />
    <nav class="nav">
      <a href="#how" class="nav-link">How to play</a>
      <a href="#videos" class="nav-link">Videos</a>
      <a href="#faq" class="nav-link">FAQ</a>
      <ThemeToggle />
      <a href={gameUrl()} class="nav-play">Play today's logo</a>
    </nav>
  </header>

  <div class="content">
    <div class="intro">
      <Title as="h1" class="hero-title" />
      <p class="tagline">Name the tech logo of the day in three tries. A new one appears every midnight.</p>
      <div class="actions">
        <a href={gameUrl()} class="btn btn-primary">Play today's logo</a>
        <a href="#how" class="btn btn-secondary">How to play</a>
      </div>
    </div>
    <div class="demo">
      <GameCard />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .pile {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .header {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px clamp(20px, 4vw, 40px);
    background: var(--glass);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .header :global(.header-title) {
    font-size: clamp(30px, 3.4vw, 40px);
    line-height: 1;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .nav-link {
    color: var(--muted);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
  }

  .nav-link:hover {
    color: var(--accent);
  }

  .nav-play {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    background: var(--yellow);
    color: var(--ink);
    padding: 9px 18px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition:
      filter 0.15s,
      transform 0.1s;
  }

  .nav-play:hover {
    filter: brightness(1.06);
    transform: translateY(-1px);
    color: var(--ink);
  }

  .nav-play:active {
    transform: scale(0.97);
  }

  .content {
    position: relative;
    z-index: 1;
    flex: 1;
    width: 100%;
    max-width: 1160px;
    margin: 0 auto;
    /* Bottom padding keeps the logo pile clear of the hero copy and card */
    padding: clamp(32px, 6vh, 72px) clamp(20px, 5vw, 56px) calc(26vh + 24px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr));
    gap: 40px 56px;
    align-items: center;
    pointer-events: none;
  }

  .intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .intro :global(.hero-title) {
    font-size: clamp(56px, 8vw, 128px);
  }

  .tagline {
    margin: 20px 0 0;
    font-size: clamp(18px, 1.7vw, 22px);
    font-weight: 500;
    line-height: 1.5;
    max-width: 30ch;
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
    pointer-events: auto;
  }

  .demo {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    pointer-events: auto;
  }

  /* Mobile: the section links don't fit next to the CTA; the page is short enough to scroll */
  @media (max-width: 720px) {
    .nav-link {
      display: none;
    }

    .nav {
      gap: 12px;
    }
  }
</style>
