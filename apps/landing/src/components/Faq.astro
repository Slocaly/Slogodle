---
import Icon from "./Icon.astro";

const faq = [
  {
    q: "When does a new logo come out?",
    a: "Every day at local midnight. Once you finish a round, a countdown shows how long until the next one.",
  },
  {
    q: "What are the hints?",
    a: "Your first wrong guess shows the year the company was founded. The second shows its industry.",
  },
  {
    q: "Do I need an account?",
    a: "No. Accounts are optional and let you save your streak and stats across devices, with email and password or GitHub sign-in.",
  },
  {
    q: "Can I play past days?",
    a: "Yes. The archive lets you replay the last 5 days, or the last 10 when you are signed in.",
  },
  {
    q: "What is the pile of logos?",
    a: "Every logo you find lands in a pile at the bottom of the screen. Solve today's in fewer tries and more copies fly in. Click the pile to scatter it.",
  },
  {
    q: "How do I share my score?",
    a: "After each round, Share result copies your score and one square per guess, ready to paste anywhere.",
  },
];
---

<section id="faq" class="faq">
  <h2>Frequently asked questions</h2>
  <div class="list">
    {
      faq.map((f) => (
        <details class="item" name="faq">
          <summary>
            <h3>{f.q}</h3>
            <span class="toggle">
              <Icon name="plus" />
            </span>
          </summary>
          <p>{f.a}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq {
    max-width: 760px;
    margin: 0 auto;
    padding: 64px clamp(20px, 5vw, 56px) 96px;
  }

  h2 {
    margin: 0 0 32px;
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 700;
    line-height: 1.1;
    text-align: center;
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .item {
    border-radius: 16px;
    background: var(--surface);
    box-shadow:
      var(--highlight),
      0 3px 0 var(--shadow);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 24px;
    cursor: pointer;
    list-style: none;
    border-radius: 16px;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  h3 {
    margin: 0;
    font-size: 17px;
    font-weight: 700;
    line-height: 1.4;
  }

  .toggle {
    display: flex;
    color: var(--muted);
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  summary:hover .toggle {
    color: var(--accent);
  }

  .item[open] .toggle {
    transform: rotate(45deg);
  }

  p {
    margin: 0;
    padding: 0 24px 22px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 60ch;
  }
</style>
